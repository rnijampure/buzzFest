generator client {
  provider = "prisma-client-js"
  // Do NOT add an 'output' property unless you want a custom location
}

datasource db {
  provider = "postgresql"
  // The 'url' line is removed!
}

model Baker {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  images      String[]
  specialty   String
  experience  String
  location    String
  description String
  rating      Float     @default(5.0)
  createdAt   DateTime  @default(now())
  products    Product[]
  tasks       Task[]

  @@index([slug])
}

model ProductVariant {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  price       Decimal          @db.Decimal(10, 2)
  category    String[]
  starRating  Float            @default(0.0)
  images      String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  creatorSlug String
  isFeatured  Boolean          @default(false)
  isVeg       Boolean          @default(true)
  stock       Int              @default(0)
  orderItems  OrderItem[]
  baker       Baker            @relation(fields: [creatorSlug], references: [slug])
  variants    ProductVariant[]
}

model Order {
  id            String      @id @default(cuid())
  customerEmail String
  totalAmount   Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  currency      String      @default("INR")
  customerName  String?
  orderNumber   Int         @unique
  updatedAt     DateTime    @updatedAt
  status        OrderStatus @default(PENDING)
  items         OrderItem[]
  tasks         Task[]
}

model OrderItem {
  id              String   @id @default(cuid())
  quantity        Int      @default(1)
  orderId         String
  productId       String?
  bakerSlug       String?
  priceAtPurchase Decimal  @db.Decimal(10, 2)
  productImage    String?
  productName     String
  instructions    String?
  message         String?
  size            String?
  variant         String?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  isDelayed      Boolean    @default(false)
  delayedUntil   DateTime
  notes          String
  orderId        String
  dueDate        DateTime
  createdAt      DateTime   @default(now())
  assignedToSlug String?
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(QUEUED)
  assignedTo     Baker?     @relation(fields: [assignedToSlug], references: [slug])
  order          Order      @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([assignedToSlug])
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
