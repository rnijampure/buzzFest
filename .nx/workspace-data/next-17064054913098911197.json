{
  "12874178012854373618": {
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/bakery-ops",
        "tty": false
      },
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "next"
          ]
        },
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/bakery-ops/.next/!(cache)/**/*",
        "{workspaceRoot}/apps/bakery-ops/.next/!(cache)"
      ],
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ]
    },
    "dev": {
      "continuous": true,
      "command": "next dev",
      "options": {
        "cwd": "apps/bakery-ops"
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ]
    },
    "start": {
      "continuous": true,
      "command": "next start",
      "options": {
        "cwd": "apps/bakery-ops"
      },
      "dependsOn": [
        "build"
      ]
    },
    "serve-static": {
      "continuous": true,
      "command": "next start",
      "options": {
        "cwd": "apps/bakery-ops"
      },
      "dependsOn": [
        "build"
      ]
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ]
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": [
        "build-deps"
      ],
      "command": "npx nx watch --projects @buzz-fest/bakery-ops --includeDependentProjects -- npx nx build-deps @buzz-fest/bakery-ops"
    }
  },
